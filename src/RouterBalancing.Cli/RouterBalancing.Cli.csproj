<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>RouterBalancing.Cli</RootNamespace>
    <!-- Tên lệnh ngắn gọn khi gõ trong terminal: rbctl provider list -->
    <AssemblyName>rbctl</AssemblyName>
    <Version>1.12.3.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- DI, HttpClientFactory, Logging đến từ shared framework này (Core cũng dùng) -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Không thêm PackageReference: DI/HttpClientFactory đến từ shared framework
         Microsoft.AspNetCore.App mà Core đã tham chiếu — build offline chỉ cần cache NuGet của Core. -->
    <ProjectReference Include="..\RouterBalancing.Core\RouterBalancing.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RouterBalancing.Cli.Tests" />
  </ItemGroup>

</Project>
